# Salin menjadi .env lalu ganti semua CHANGE_ME. Jangan pernah commit file .env.
POSTGRES_USER=tanda
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=tanda_tambah
# Minimal 32 karakter acak, contoh: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=CHANGE_ME
# Akun admin pusat pertama (dibuat sekali saat migrate)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME
COOKIE_SECURE=true
SITE_DOMAIN=localhost
WEB_PORT=3000
