# ───────────────────────── Core ─────────────────────────
NODE_ENV=development
TZ=UTC
APP_DISPLAY_TIMEZONE=Asia/Jakarta

# ───────────────────────── Database ─────────────────────────
# PostgreSQL is the system of record. Never point this to Google Sheets.
DATABASE_URL=postgresql://tanda:CHANGE_ME@localhost:5432/tanda_tambah?schema=public

# ───────────────────────── Redis (cache, BullMQ, rate limit) ─────────────────────────
REDIS_URL=redis://localhost:6379
QUEUES_ENABLED=true

# ───────────────────────── API ─────────────────────────
API_PORT=4000
API_PUBLIC_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:3000
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=CHANGE_ME_LONG_RANDOM
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7
COOKIE_SECURE=false
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX=300
LOGIN_RATE_LIMIT_MAX=10

# ───────────────────────── File storage ─────────────────────────
# local = filesystem (dev/test only) | s3 = any S3-compatible store (AWS S3, MinIO, R2, GCS-interop)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
S3_ENDPOINT=http://localhost:9000
S3_REGION=ap-southeast-3
S3_BUCKET=tanda-tambah
S3_ACCESS_KEY_ID=CHANGE_ME
S3_SECRET_ACCESS_KEY=CHANGE_ME
S3_FORCE_PATH_STYLE=true
UPLOAD_MAX_BYTES=10485760
UPLOAD_ALLOWED_MIME=image/jpeg,image/png,image/webp,application/pdf

# ───────────────────────── Google integration (optional) ─────────────────────────
# Service account JSON (base64). Leave empty to disable Drive/Sheets polling.
GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=
GOOGLE_DRIVE_INBOX_FOLDER_ID=
GOOGLE_SHEETS_SPREADSHEET_ID=
DRIVE_POLL_CRON=*/10 * * * *

# ───────────────────────── OCR ─────────────────────────
# none = human transcription only | google_vision = Google Cloud Vision (uses service account above)
OCR_PROVIDER=none

# ───────────────────────── Web ─────────────────────────
WEB_PORT=3000
# Server-side URL the Next.js proxy forwards /api/v1 to
API_INTERNAL_URL=http://localhost:4000

# ───────────────────────── Seed ─────────────────────────
SEED_SUPERADMIN_EMAIL=superadmin@tanda-tambah.local
SEED_SUPERADMIN_PASSWORD=CHANGE_ME_Str0ng!
