     "dashboard"
    ],
    "summary": "Dashboard",
    "operationId": "dashboard_api_v1_dashboard_get",
    "parameters": [
     {
      "name": "type",
      "in": "query",
      "required": false,
      "schema": {
       "type": "string",
       "pattern": "^(GROSIR|HORECA|REGULER)$",
       "default": "GROSIR",
       "title": "Type"
      }
     },
     {
      "name": "days",
      "in": "query",
      "required": false,
      "schema": {
       "type": "integer",
       "maximum": 366,
       "minimum": 1,
       "default": 30,
       "title": "Days"
      }
     },
     {
      "name": "spg",
      "in": "query",
