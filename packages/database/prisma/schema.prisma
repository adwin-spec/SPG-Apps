// ════════════════════════════════════════════════════════════════════════════
// Tanda Tambah – SPG Performance & Market Intelligence System
// PostgreSQL schema (system of record). All timestamps are stored in UTC
// (timestamptz). Business dates (work date, period) are `date` in Asia/Jakarta.
// ════════════════════════════════════════════════════════════════════════════

generator client {
  provider        = "prisma-client-js"
  output          = "../generated/client"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pg_trgm, pgcrypto]
}

// ───────────────────────────── Enums ─────────────────────────────

enum SpgCategoryCode {
  GROSIR
  HORECA
  REGULER
}

enum RecordStatus {
  ACTIVE
  INACTIVE
}

enum SpgStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE
  RESIGNED
}

enum OutletChannel {
  WHOLESALER
  RETAILER
  HORECA
  REGULAR
}

enum OutletStatus {
  PROSPECT
  ACTIVE
  INACTIVE
  CLOSED
}

enum RelationType {
  PRIMARY
  ALTERNATIVE
}

enum ProductOwner {
  COMPANY
  COMPETITOR
}

enum DataNature {
  ACTUAL
  ESTIMATE
  OBSERVATION
}

enum DataSource {
  MANUAL
  OFFLINE_SYNC
  OCR
  IMPORT
}

/// Three-layer data state: SUBMITTED = raw, VALIDATED/NEEDS_REVIEW = automated rules, APPROVED = human.
enum ValidationStatus {
  SUBMITTED
  VALIDATED
  NEEDS_REVIEW
  APPROVED
  REJECTED
  SUPERSEDED
  REVERSED
}

enum GeofenceStatus {
  INSIDE
  OUTSIDE
  UNKNOWN
}

enum VisitStatus {
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum VisitPlanStatus {
  PLANNED
  VISITED
  MISSED
  CANCELLED
}

enum AttendanceStatus {
  CHECKED_IN
  CHECKED_OUT
  ABSENT
  LEAVE
}

enum ReportStatus {
  DRAFT
  SUBMITTED
  REVISION_REQUIRED
  APPROVED
}

enum StockAvailability {
  IN_STOCK
  LOW_STOCK
  OUT_OF_STOCK
  UNKNOWN
}

enum OrderStatus {
  NO_ORDER
  ORDERED
  CONFIRMED
  DELIVERED
  CANCELLED
}

enum PosmStatus {
  INSTALLED
  MISSING
  DAMAGED
  NOT_APPLICABLE
}

enum ProgramStatus {
  DRAFT
  ACTIVE
  CLOSED
}

enum ImplementationStatus {
  PLANNED
  EXECUTED
  PARTIAL
  NOT_EXECUTED
}

enum KpiDimension {
  PRODUCTIVITY
  COVERAGE
  COMMERCIAL
  EXECUTION
  INTELLIGENCE
  DATA_QUALITY
  REPORTING_COMPLIANCE
}

enum KpiDirection {
  HIGHER_IS_BETTER
  LOWER_IS_BETTER
}

enum KpiPeriod {
  MONTHLY
}

enum KpiDataStatus {
  OK
  NO_DATA
  NO_TARGET
  ZERO_TARGET
}

enum FileSource {
  APP_UPLOAD
  GOOGLE_DRIVE
}

enum FileLogStatus {
  UPLOADED
  PROCESSING
  OCR_COMPLETED
  NEEDS_REVIEW
  APPROVED
  REJECTED
  SYNC_FAILED
}

enum DuplicateType {
  NONE
  EXACT_DUPLICATE
  POTENTIAL_DUPLICATE
  RE_UPLOAD
  CORRECTED_SUBMISSION
}

enum SyncJobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum Severity {
  INFO
  WARNING
  CRITICAL
}

enum IssueStatus {
  OPEN
  RESOLVED
  IGNORED
}

// ───────────────────────────── Organization ─────────────────────────────

model Company {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique @db.VarChar(32)
  name      String   @db.VarChar(160)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  regions   Region[]

  @@map("companies")
}

model Region {
  id        String       @id @default(uuid()) @db.Uuid
  companyId String       @map("company_id") @db.Uuid
  code      String       @unique @db.VarChar(32)
  name      String       @db.VarChar(120)
  status    RecordStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  company   Company      @relation(fields: [companyId], references: [id])
  areas     Area[]
  users     User[]

  @@index([companyId])
  @@map("regions")
}

model Area {
  id          String          @id @default(uuid()) @db.Uuid
  regionId    String          @map("region_id") @db.Uuid
  code        String          @unique @db.VarChar(32)
  name        String          @db.VarChar(120)
  status      RecordStatus    @default(ACTIVE)
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  region      Region          @relation(fields: [regionId], references: [id])
  districts   District[]
  territories Territory[]
  supervisors Supervisor[]
  users       User[]
  spgs        Spg[]
  assignments SpgAssignment[]

  @@index([regionId])
  @@map("areas")
}

/// Kabupaten / Kota
model District {
  id           String        @id @default(uuid()) @db.Uuid
  areaId       String        @map("area_id") @db.Uuid
  code         String        @unique @db.VarChar(32)
  name         String        @db.VarChar(120)
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  area         Area          @relation(fields: [areaId], references: [id])
  subdistricts Subdistrict[]
  outlets      Outlet[]

  @@index([areaId])
  @@map("districts")
}

/// Kecamatan
model Subdistrict {
  id         String   @id @default(uuid()) @db.Uuid
  districtId String   @map("district_id") @db.Uuid
  code       String   @unique @db.VarChar(32)
  name       String   @db.VarChar(120)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  district   District @relation(fields: [districtId], references: [id])
  outlets    Outlet[]

  @@index([districtId])
  @@map("subdistricts")
}

model Territory {
  id          String          @id @default(uuid()) @db.Uuid
  areaId      String          @map("area_id") @db.Uuid
  code        String          @unique @db.VarChar(32)
  name        String          @db.VarChar(120)
  description String?
  status      RecordStatus    @default(ACTIVE)
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  area        Area            @relation(fields: [areaId], references: [id])
  assignments SpgAssignment[]

  @@index([areaId])
  @@map("territories")
}

model Supervisor {
  id          String          @id @default(uuid()) @db.Uuid
  userId      String          @unique @map("user_id") @db.Uuid
  areaId      String          @map("area_id") @db.Uuid
  status      RecordStatus    @default(ACTIVE)
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  user        User            @relation(fields: [userId], references: [id])
  area        Area            @relation(fields: [areaId], references: [id])
  spgs        Spg[]
  assignments SpgAssignment[]

  @@index([areaId])
  @@map("supervisors")
}

/// Effective-dated history of SPG ↔ area / territory / supervisor. effective_to NULL = current.
model SpgAssignment {
  id            String      @id @default(uuid()) @db.Uuid
  spgId         String      @map("spg_id") @db.Uuid
  areaId        String      @map("area_id") @db.Uuid
  territoryId   String?     @map("territory_id") @db.Uuid
  supervisorId  String?     @map("supervisor_id") @db.Uuid
  effectiveFrom DateTime    @map("effective_from") @db.Date
  effectiveTo   DateTime?   @map("effective_to") @db.Date
  reason        String?
  createdById   String?     @map("created_by_id") @db.Uuid
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  spg           Spg         @relation(fields: [spgId], references: [id])
  area          Area        @relation(fields: [areaId], references: [id])
  territory     Territory?  @relation(fields: [territoryId], references: [id])
  supervisor    Supervisor? @relation(fields: [supervisorId], references: [id])

  @@index([spgId, effectiveFrom])
  @@index([supervisorId])
  @@map("spg_assignments")
}

// ───────────────────────────── Users & RBAC ─────────────────────────────

model User {
  id               String         @id @default(uuid()) @db.Uuid
  email            String         @unique @db.VarChar(254)
  passwordHash     String         @map("password_hash")
  fullName         String         @map("full_name") @db.VarChar(160)
  phone            String?        @db.VarChar(32)
  isActive         Boolean        @default(true) @map("is_active")
  /// Territorial scope for Regional / Area managers (nullable for national roles).
  regionId         String?        @map("region_id") @db.Uuid
  areaId           String?        @map("area_id") @db.Uuid
  failedLoginCount Int            @default(0) @map("failed_login_count")
  lockedUntil      DateTime?      @map("locked_until") @db.Timestamptz(6)
  lastLoginAt      DateTime?      @map("last_login_at") @db.Timestamptz(6)
  passwordChangedAt DateTime?     @map("password_changed_at") @db.Timestamptz(6)
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  region           Region?        @relation(fields: [regionId], references: [id])
  area             Area?          @relation(fields: [areaId], references: [id])
  roles            UserRole[]
  refreshTokens    RefreshToken[]
  supervisor       Supervisor?
  spg              Spg?
  notifications    Notification[]

  @@map("users")
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique @db.VarChar(48)
  name        String           @db.VarChar(120)
  description String?
  isSystem    Boolean          @default(false) @map("is_system")
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique @db.VarChar(80)
  module      String           @db.VarChar(48)
  description String?
  roles       RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

/// Hashed refresh tokens; rotation chain via family_id. Reuse of a revoked token revokes the family.
model RefreshToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.VarChar(128)
  familyId   String    @map("family_id") @db.Uuid
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)
  replacedBy String?   @map("replaced_by") @db.Uuid
  userAgent  String?   @map("user_agent") @db.VarChar(300)
  ip         String?   @db.VarChar(64)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

// ───────────────────────────── SPG ─────────────────────────────

model SpgCategory {
  id             String          @id @default(uuid()) @db.Uuid
  code           SpgCategoryCode @unique
  name           String          @db.VarChar(80)
  description    String?
  spgs           Spg[]
  kpiDefinitions KpiDefinition[]

  @@map("spg_categories")
}

model Spg {
  id                  String                 @id @default(uuid()) @db.Uuid
  employeeCode        String                 @unique @map("employee_code") @db.VarChar(32)
  userId              String?                @unique @map("user_id") @db.Uuid
  fullName            String                 @map("full_name") @db.VarChar(160)
  phone               String?                @db.VarChar(32)
  categoryId          String                 @map("category_id") @db.Uuid
  status              SpgStatus              @default(ACTIVE)
  joinDate            DateTime               @map("join_date") @db.Date
  endDate             DateTime?              @map("end_date") @db.Date
  /// Denormalised current assignment (history lives in spg_assignments).
  currentAreaId       String                 @map("current_area_id") @db.Uuid
  currentSupervisorId String?                @map("current_supervisor_id") @db.Uuid
  version             Int                    @default(1)
  createdAt           DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
  user                User?                  @relation(fields: [userId], references: [id])
  category            SpgCategory            @relation(fields: [categoryId], references: [id])
  currentArea         Area                   @relation(fields: [currentAreaId], references: [id])
  currentSupervisor   Supervisor?            @relation(fields: [currentSupervisorId], references: [id])
  assignments         SpgAssignment[]
  employmentHistory   SpgEmploymentHistory[]
  assignedOutlets     Outlet[]
  attendance          Attendance[]
  visits              Visit[]
  visitPlans          VisitPlan[]
  dailyReports        DailyReport[]
  retailerTransactions RetailerTransaction[]
  competitorObservations CompetitorObservation[]
  horecaSales         HorecaSale[]
  programImplementations HorecaProgramImplementation[]
  availabilityRecords AvailabilityRecord[]
  visibilityRecords   VisibilityRecord[]
  posmRecords         PosmRecord[]
  outletOrders        OutletOrder[]
  wholesaleObservations WholesaleObservation[]
  targetAssignments   TargetAssignment[]
  performanceResults  PerformanceResult[]
  performanceSnapshots PerformanceSnapshot[]

  @@index([categoryId, status])
  @@index([currentAreaId])
  @@index([currentSupervisorId])
  @@map("spgs")
}

model SpgEmploymentHistory {
  id            String   @id @default(uuid()) @db.Uuid
  spgId         String   @map("spg_id") @db.Uuid
  eventType     String   @map("event_type") @db.VarChar(40)
  fromValue     Json?    @map("from_value")
  toValue       Json?    @map("to_value")
  effectiveDate DateTime @map("effective_date") @db.Date
  note          String?
  createdById   String?  @map("created_by_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  spg           Spg      @relation(fields: [spgId], references: [id])

  @@index([spgId, effectiveDate])
  @@map("spg_employment_history")
}

// ───────────────────────────── Master data ─────────────────────────────

model OutletCategory {
  id       String        @id @default(uuid()) @db.Uuid
  code     String        @unique @db.VarChar(40)
  name     String        @db.VarChar(120)
  channel  OutletChannel
  isActive Boolean       @default(true) @map("is_active")
  outlets  Outlet[]

  @@index([channel])
  @@map("outlet_categories")
}

/// Unified outlet master (ADR D1): wholesalers (grosir), retailers, HORECA and regular outlets.
model Outlet {
  id                String         @id @default(uuid()) @db.Uuid
  code              String         @unique @db.VarChar(40)
  name              String         @db.VarChar(200)
  /// lower-case, punctuation-stripped, collapsed whitespace; used for duplicate detection (pg_trgm).
  normalizedName    String         @map("normalized_name") @db.VarChar(200)
  channel           OutletChannel
  categoryId        String?        @map("category_id") @db.Uuid
  address           String?
  districtId        String         @map("district_id") @db.Uuid
  subdistrictId     String?        @map("subdistrict_id") @db.Uuid
  latitude          Decimal?       @db.Decimal(9, 6)
  longitude         Decimal?       @db.Decimal(9, 6)
  geofenceRadiusM   Int?           @map("geofence_radius_m")
  picName           String?        @map("pic_name") @db.VarChar(120)
  phone             String?        @db.VarChar(32)
  potentialClass    String?        @map("potential_class") @db.VarChar(16)
  status            OutletStatus   @default(ACTIVE)
  assignedSpgId     String?        @map("assigned_spg_id") @db.Uuid
  firstRecordedAt   DateTime       @default(now()) @map("first_recorded_at") @db.Timestamptz(6)
  createdById       String?        @map("created_by_id") @db.Uuid
  version           Int            @default(1)
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  category          OutletCategory? @relation(fields: [categoryId], references: [id])
  district          District       @relation(fields: [districtId], references: [id])
  subdistrict       Subdistrict?   @relation(fields: [subdistrictId], references: [id])
  assignedSpg       Spg?           @relation(fields: [assignedSpgId], references: [id])
  assignmentHistory OutletAssignmentHistory[]
  retailerLinks     RetailerWholesaleRelationship[] @relation("RetailerSide")
  wholesalerLinks   RetailerWholesaleRelationship[] @relation("WholesalerSide")
  visits            Visit[]
  visitPlans        VisitPlan[]
  transactionsAsRetailer   RetailerTransaction[] @relation("TxRetailer")
  transactionsAsWholesaler RetailerTransaction[] @relation("TxWholesaler")
  competitorObservations   CompetitorObservation[] @relation("ObsOutlet")
  competitorObsAsWholesaler CompetitorObservation[] @relation("ObsWholesaler")
  wholesaleObservations    WholesaleObservation[]
  horecaSales       HorecaSale[]
  programImplementations HorecaProgramImplementation[]
  availabilityRecords AvailabilityRecord[]
  visibilityRecords VisibilityRecord[]
  posmRecords       PosmRecord[]
  outletOrders      OutletOrder[]

  @@index([channel, status])
  @@index([districtId])
  @@index([subdistrictId])
  @@index([assignedSpgId])
  @@map("outlets")
}

model OutletAssignmentHistory {
  id            String    @id @default(uuid()) @db.Uuid
  outletId      String    @map("outlet_id") @db.Uuid
  spgId         String?   @map("spg_id") @db.Uuid
  effectiveFrom DateTime  @map("effective_from") @db.Timestamptz(6)
  effectiveTo   DateTime? @map("effective_to") @db.Timestamptz(6)
  reason        String?
  createdById   String?   @map("created_by_id") @db.Uuid
  outlet        Outlet    @relation(fields: [outletId], references: [id])

  @@index([outletId, effectiveFrom])
  @@map("outlet_assignment_history")
}

/// Many-to-many: one retailer buys from several wholesalers, one wholesaler serves many retailers.
model RetailerWholesaleRelationship {
  id                 String       @id @default(uuid()) @db.Uuid
  retailerOutletId   String       @map("retailer_outlet_id") @db.Uuid
  wholesalerOutletId String       @map("wholesaler_outlet_id") @db.Uuid
  relationType       RelationType @map("relation_type")
  effectiveFrom      DateTime     @default(now()) @map("effective_from") @db.Timestamptz(6)
  effectiveTo        DateTime?    @map("effective_to") @db.Timestamptz(6)
  createdById        String?      @map("created_by_id") @db.Uuid
  retailer           Outlet       @relation("RetailerSide", fields: [retailerOutletId], references: [id])
  wholesaler         Outlet       @relation("WholesalerSide", fields: [wholesalerOutletId], references: [id])

  @@index([retailerOutletId])
  @@index([wholesalerOutletId])
  @@map("retailer_wholesale_relationships")
}

model Competitor {
  id       String              @id @default(uuid()) @db.Uuid
  code     String              @unique @db.VarChar(40)
  name     String              @db.VarChar(160)
  isActive Boolean             @default(true) @map("is_active")
  brands   Brand[]
  products CompetitorProduct[]

  @@map("competitors")
}

model Brand {
  id                 String              @id @default(uuid()) @db.Uuid
  code               String              @unique @db.VarChar(40)
  name               String              @db.VarChar(120)
  owner              ProductOwner
  competitorId       String?             @map("competitor_id") @db.Uuid
  isActive           Boolean             @default(true) @map("is_active")
  competitor         Competitor?         @relation(fields: [competitorId], references: [id])
  products           Product[]
  competitorProducts CompetitorProduct[]
  observations       CompetitorObservation[]

  @@index([owner])
  @@map("brands")
}

model Product {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique @db.VarChar(40)
  name        String           @db.VarChar(200)
  brandId     String           @map("brand_id") @db.Uuid
  category    String?          @db.VarChar(80)
  isActive    Boolean          @default(true) @map("is_active")
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  brand       Brand            @relation(fields: [brandId], references: [id])
  variants    ProductVariant[]

  @@index([brandId])
  @@map("products")
}

/// The SKU level. All transaction/order lines reference a variant.
model ProductVariant {
  id           String   @id @default(uuid()) @db.Uuid
  productId    String   @map("product_id") @db.Uuid
  sku          String   @unique @db.VarChar(60)
  name         String   @db.VarChar(200)
  size         String?  @db.VarChar(40)
  unit         String   @db.VarChar(20)
  packSize     Int?     @map("pack_size")
  /// Reference list price; transactional prices are always captured per line.
  listPrice    Decimal? @map("list_price") @db.Decimal(18, 2)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  product      Product  @relation(fields: [productId], references: [id])
  transactionItems RetailerTransactionItem[]
  horecaSales  HorecaSale[]
  availability AvailabilityRecord[]
  orderItems   OutletOrderItem[]
  wholesaleObservations WholesaleObservation[]

  @@index([productId])
  @@map("product_variants")
}

model CompetitorProduct {
  id           String     @id @default(uuid()) @db.Uuid
  competitorId String     @map("competitor_id") @db.Uuid
  brandId      String     @map("brand_id") @db.Uuid
  sku          String?    @db.VarChar(60)
  name         String     @db.VarChar(200)
  variant      String?    @db.VarChar(80)
  unit         String?    @db.VarChar(20)
  isActive     Boolean    @default(true) @map("is_active")
  competitor   Competitor @relation(fields: [competitorId], references: [id])
  brand        Brand      @relation(fields: [brandId], references: [id])
  transactionItems RetailerTransactionItem[]
  observations CompetitorObservation[]

  @@unique([brandId, name, variant])
  @@index([competitorId])
  @@map("competitor_products")
}

