  validationStatus ValidationStatus @default(SUBMITTED) @map("validation_status")
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  spg              Spg              @relation(fields: [spgId], references: [id])
  outlet           Outlet           @relation(fields: [outletId], references: [id])

  @@index([outletId, recordDate])
  @@index([spgId, recordDate])
  @@map("posm_records")
}

model OutletOrder {
  id               String           @id @default(uuid()) @db.Uuid
  orderNo          String           @unique @map("order_no") @db.VarChar(40)
  clientId         String           @unique @map("client_id") @db.Uuid
  spgId            String           @map("spg_id") @db.Uuid
  visitId          String?          @map("visit_id") @db.Uuid
  outletId         String           @map("outlet_id") @db.Uuid
  orderDate        DateTime         @map("order_date") @db.Date
  status           OrderStatus      @default(ORDERED)
  isRestock        Boolean          @default(false) @map("is_restock")
  totalQuantity    Decimal          @default(0) @map("total_quantity") @db.Decimal(14, 3)
  totalValue       Decimal          @default(0) @map("total_value") @db.Decimal(18, 2)
  dataNature       DataNature       @default(ACTUAL) @map("data_nature")
  validationStatus ValidationStatus @default(SUBMITTED) @map("validation_status")
  correctionOfId   String?          @map("correction_of_id") @db.Uuid
  approvedById     String?          @map("approved_by_id") @db.Uuid
  approvedAt       DateTime?        @map("approved_at") @db.Timestamptz(6)
  notes            String?
  version          Int              @default(1)
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  spg              Spg              @relation(fields: [spgId], references: [id])
  outlet           Outlet           @relation(fields: [outletId], references: [id])
  items            OutletOrderItem[]

  @@index([spgId, orderDate])
  @@index([outletId, orderDate])
  @@index([validationStatus, orderDate])
  @@map("outlet_orders")
}

model OutletOrderItem {
  id               String         @id @default(uuid()) @db.Uuid
  orderId          String         @map("order_id") @db.Uuid
  lineNo           Int            @map("line_no")
  productVariantId String         @map("product_variant_id") @db.Uuid
  quantity         Decimal        @db.Decimal(14, 3)
  unit             String         @db.VarChar(20)
  unitPrice        Decimal        @map("unit_price") @db.Decimal(18, 2)
  lineTotal        Decimal        @map("line_total") @db.Decimal(18, 2)
  order            OutletOrder    @relation(fields: [orderId], references: [id])
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id])

  @@unique([orderId, lineNo])
  @@index([productVariantId])
  @@map("outlet_order_items")
}

// ───────────────────────────── KPI engine ─────────────────────────────

model KpiDefinition {
  id          String        @id @default(uuid()) @db.Uuid
  code        String        @unique @db.VarChar(60)
  name        String        @db.VarChar(160)
  description String?
  categoryId  String        @map("category_id") @db.Uuid
  dimension   KpiDimension
  unit        String        @db.VarChar(20)
  period      KpiPeriod     @default(MONTHLY)
  direction   KpiDirection  @default(HIGHER_IS_BETTER)
  /// true = activity KPI, false = business-outcome KPI (scored separately).
  isActivity  Boolean       @map("is_activity")
  dataSource  String?       @map("data_source")
  displayOrder Int          @default(0) @map("display_order")
  isActive    Boolean       @default(true) @map("is_active")
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  category    SpgCategory   @relation(fields: [categoryId], references: [id])
  formulas    KpiFormula[]
  weights     KpiWeight[]
  targets     Target[]
  targetAssignments TargetAssignment[]
  results     PerformanceResult[]

  @@index([categoryId, isActive])
  @@map("kpi_definitions")
}

/// Versioned formula: metric from the server-side catalogue + params + cap + thresholds.
model KpiFormula {
  id                String        @id @default(uuid()) @db.Uuid
  kpiDefinitionId   String        @map("kpi_definition_id") @db.Uuid
  version           Int
  metricKey         String        @map("metric_key") @db.VarChar(80)
  params            Json          @default("{}")
  achievementCapPct Decimal?      @map("achievement_cap_pct") @db.Decimal(6, 2)
  thresholds        Json?
  effectiveFrom     DateTime      @map("effective_from") @db.Date
  effectiveTo       DateTime?     @map("effective_to") @db.Date
  createdById       String?       @map("created_by_id") @db.Uuid
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  kpiDefinition     KpiDefinition @relation(fields: [kpiDefinitionId], references: [id])

  @@unique([kpiDefinitionId, version])
  @@index([kpiDefinitionId, effectiveFrom])
  @@map("kpi_formulas")
}

model KpiWeight {
  id              String        @id @default(uuid()) @db.Uuid
  kpiDefinitionId String        @map("kpi_definition_id") @db.Uuid
  weightPct       Decimal       @map("weight_pct") @db.Decimal(6, 2)
  effectiveFrom   DateTime      @map("effective_from") @db.Date
  effectiveTo     DateTime?     @map("effective_to") @db.Date
  reason          String?
  createdById     String?       @map("created_by_id") @db.Uuid
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  kpiDefinition   KpiDefinition @relation(fields: [kpiDefinitionId], references: [id])

  @@index([kpiDefinitionId, effectiveFrom])
  @@map("kpi_weights")
}

/// Category-default target for a KPI and month. Absence of a row = target UNDEFINED (≠ 0).
model Target {
  id              String        @id @default(uuid()) @db.Uuid
  kpiDefinitionId String        @map("kpi_definition_id") @db.Uuid
  periodMonth     DateTime      @map("period_month") @db.Date
  value           Decimal       @db.Decimal(18, 4)
  isCurrent       Boolean       @default(true) @map("is_current")
  reason          String?
  createdById     String?       @map("created_by_id") @db.Uuid
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  kpiDefinition   KpiDefinition @relation(fields: [kpiDefinitionId], references: [id])

  @@index([kpiDefinitionId, periodMonth, isCurrent])
  @@map("targets")
}

/// Per-SPG override of the category target (history kept via is_current).
model TargetAssignment {
  id              String        @id @default(uuid()) @db.Uuid
  kpiDefinitionId String        @map("kpi_definition_id") @db.Uuid
  spgId           String        @map("spg_id") @db.Uuid
  periodMonth     DateTime      @map("period_month") @db.Date
  value           Decimal       @db.Decimal(18, 4)
  isCurrent       Boolean       @default(true) @map("is_current")
  reason          String?
  createdById     String?       @map("created_by_id") @db.Uuid
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  kpiDefinition   KpiDefinition @relation(fields: [kpiDefinitionId], references: [id])
  spg             Spg           @relation(fields: [spgId], references: [id])

  @@index([spgId, periodMonth, isCurrent])
  @@index([kpiDefinitionId, periodMonth])
  @@map("target_assignments")
}

model PerformanceResult {
  id              String        @id @default(uuid()) @db.Uuid
  spgId           String        @map("spg_id") @db.Uuid
  kpiDefinitionId String        @map("kpi_definition_id") @db.Uuid
  periodMonth     DateTime      @map("period_month") @db.Date
  formulaVersion  Int           @map("formula_version")
  actualValue     Decimal?      @map("actual_value") @db.Decimal(18, 4)
  targetValue     Decimal?      @map("target_value") @db.Decimal(18, 4)
  targetSource    String?       @map("target_source") @db.VarChar(20)
  achievementPct  Decimal?      @map("achievement_pct") @db.Decimal(9, 2)
  scoredPct       Decimal?      @map("scored_pct") @db.Decimal(9, 2)
  weightPct       Decimal?      @map("weight_pct") @db.Decimal(6, 2)
  weightedScore   Decimal?      @map("weighted_score") @db.Decimal(9, 4)
  dataStatus      KpiDataStatus @map("data_status")
  sourceCount     Int           @default(0) @map("source_count")
  /// numerator/denominator + filters actually used, for traceability.
  trace           Json?
  computedAt      DateTime      @default(now()) @map("computed_at") @db.Timestamptz(6)
  spg             Spg           @relation(fields: [spgId], references: [id])
  kpiDefinition   KpiDefinition @relation(fields: [kpiDefinitionId], references: [id])

  @@unique([spgId, kpiDefinitionId, periodMonth])
  @@index([periodMonth])
  @@map("performance_results")
}

model PerformanceSnapshot {
  id             String   @id @default(uuid()) @db.Uuid
  spgId          String   @map("spg_id") @db.Uuid
  periodMonth    DateTime @map("period_month") @db.Date
  totalScore     Decimal? @map("total_score") @db.Decimal(9, 2)
  activityScore  Decimal? @map("activity_score") @db.Decimal(9, 2)
  outcomeScore   Decimal? @map("outcome_score") @db.Decimal(9, 2)
  weightCoverage Decimal? @map("weight_coverage") @db.Decimal(6, 2)
  rankInCategory Int?     @map("rank_in_category")
  performanceStatus String? @map("performance_status") @db.VarChar(20)
  isLocked       Boolean  @default(false) @map("is_locked")
  lockedById     String?  @map("locked_by_id") @db.Uuid
  lockedAt       DateTime? @map("locked_at") @db.Timestamptz(6)
  configSnapshot Json?    @map("config_snapshot")
  computedAt     DateTime @default(now()) @map("computed_at") @db.Timestamptz(6)
  spg            Spg      @relation(fields: [spgId], references: [id])

  @@unique([spgId, periodMonth])
  @@index([periodMonth])
  @@map("performance_snapshots")
}

// ───────────────────────────── Files, OCR & integration ─────────────────────────────

model FileObject {
  id             String     @id @default(uuid()) @db.Uuid
  storageKey     String     @unique @map("storage_key") @db.VarChar(400)
  originalName   String     @map("original_name") @db.VarChar(260)
  mimeType       String     @map("mime_type") @db.VarChar(100)
  sizeBytes      Int        @map("size_bytes")
  checksumSha256 String     @map("checksum_sha256") @db.VarChar(64)
  source         FileSource @default(APP_UPLOAD)
  externalId     String?    @map("external_id") @db.VarChar(200)
  uploadedById   String?    @map("uploaded_by_id") @db.Uuid
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  evidence       VisitEvidence[]
  fileLogs       FileLog[]

  @@index([checksumSha256])
  @@index([externalId])
  @@map("files")
}

/// One row per paper-form submission moving through the OCR pipeline.
model FileLog {
  id                 String        @id @default(uuid()) @db.Uuid
  fileId             String        @map("file_id") @db.Uuid
  formId             String?       @map("form_id") @db.VarChar(60)
  spgId              String?       @map("spg_id") @db.Uuid
  wholesalerOutletId String?       @map("wholesaler_outlet_id") @db.Uuid
  reportDate         DateTime?     @map("report_date") @db.Date
  status             FileLogStatus @default(UPLOADED)
  duplicateType      DuplicateType @default(NONE) @map("duplicate_type")
  duplicateOfId      String?       @map("duplicate_of_id") @db.Uuid
  attempts           Int           @default(0)
  lastError          String?       @map("last_error")
  sheetRowRef        String?       @map("sheet_row_ref") @db.VarChar(60)
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  file               FileObject    @relation(fields: [fileId], references: [id])
  ocrRaw             OcrRaw[]

  @@index([status, createdAt])
  @@index([spgId, reportDate])
  @@map("file_logs")
}

/// Immutable OCR output (DB trigger blocks UPDATE/DELETE).
model OcrRaw {
  id            String      @id @default(uuid()) @db.Uuid
  fileLogId     String      @map("file_log_id") @db.Uuid
  provider      String      @db.VarChar(40)
  rawText       String?     @map("raw_text")
  rawJson       Json?       @map("raw_json")
  parsedFields  Json        @map("parsed_fields")
  confidence    Decimal?    @db.Decimal(5, 4)
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  fileLog       FileLog     @relation(fields: [fileLogId], references: [id])
  reviews       OcrReview[]

  @@index([fileLogId])
  @@map("ocr_raw")
}

model OcrReview {
  id                  String         @id @default(uuid()) @db.Uuid
  ocrRawId            String         @map("ocr_raw_id") @db.Uuid
  reviewerId          String         @map("reviewer_id") @db.Uuid
  /// [{ path, originalValue, correctedValue, reason }]
  corrections         Json
  finalPayload        Json           @map("final_payload")
  status              ApprovalStatus @default(PENDING)
  decisionNote        String?        @map("decision_note")
  approvedById        String?        @map("approved_by_id") @db.Uuid
  approvedAt          DateTime?      @map("approved_at") @db.Timestamptz(6)
  resultTransactionId String?        @map("result_transaction_id") @db.Uuid
  createdAt           DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  ocrRaw              OcrRaw         @relation(fields: [ocrRawId], references: [id])

  @@index([status])
  @@map("ocr_reviews")
}

model SyncJob {
  id          String         @id @default(uuid()) @db.Uuid
  integration String         @db.VarChar(40)
  jobType     String         @map("job_type") @db.VarChar(60)
  status      SyncJobStatus  @default(QUEUED)
  startedAt   DateTime?      @map("started_at") @db.Timestamptz(6)
  finishedAt  DateTime?      @map("finished_at") @db.Timestamptz(6)
  stats       Json?
  error       String?
  triggeredById String?      @map("triggered_by_id") @db.Uuid
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  logs        IntegrationLog[]

  @@index([integration, createdAt])
  @@map("sync_jobs")
}

model IntegrationLog {
  id        String   @id @default(uuid()) @db.Uuid
  syncJobId String?  @map("sync_job_id") @db.Uuid
  level     Severity
  message   String
  context   Json?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  syncJob   SyncJob? @relation(fields: [syncJobId], references: [id])

  @@index([syncJobId])
  @@index([createdAt])
  @@map("integration_logs")
}

// ───────────────────────────── System ─────────────────────────────

/// Generic approval workflow for corrections, reversals, overrides and master-data changes.
model Approval {
  id              String         @id @default(uuid()) @db.Uuid
  entityType      String         @map("entity_type") @db.VarChar(60)
  entityId        String         @map("entity_id") @db.Uuid
  requestType     String         @map("request_type") @db.VarChar(40)
  status          ApprovalStatus @default(PENDING)
  originalSnapshot Json?         @map("original_snapshot")
  proposedChange  Json?          @map("proposed_change")
  reason          String
  requestedById   String         @map("requested_by_id") @db.Uuid
  decidedById     String?        @map("decided_by_id") @db.Uuid
  decidedAt       DateTime?      @map("decided_at") @db.Timestamptz(6)
  decisionNote    String?        @map("decision_note")
  resultEntityId  String?        @map("result_entity_id") @db.Uuid
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([status, createdAt])
  @@index([entityType, entityId])
  @@map("approvals")
}

model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  type      String    @db.VarChar(60)
  severity  Severity  @default(INFO)
  title     String    @db.VarChar(200)
  body      String?
  link      String?   @db.VarChar(300)
  dedupKey  String?   @unique @map("dedup_key") @db.VarChar(200)
  readAt    DateTime? @map("read_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@map("notifications")
}

/// Append-only (DB trigger blocks UPDATE/DELETE).
model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String   @db.VarChar(60)
  entityType String   @map("entity_type") @db.VarChar(60)
  entityId   String?  @map("entity_id") @db.VarChar(64)
  before     Json?
  after      Json?
  reason     String?
  ip         String?  @db.VarChar(64)
  userAgent  String?  @map("user_agent") @db.VarChar(300)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}

model SystemSetting {
  key         String   @id @db.VarChar(100)
  value       Json
  description String?
  isSimulationDefault Boolean @default(false) @map("is_simulation_default")
  updatedById String?  @map("updated_by_id") @db.Uuid
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("system_settings")
}

model IdempotencyKey {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  key            String   @db.VarChar(100)
  method         String   @db.VarChar(10)
  path           String   @db.VarChar(300)
  requestHash    String   @map("request_hash") @db.VarChar(64)
  responseStatus Int?     @map("response_status")
  responseBody   Json?    @map("response_body")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([userId, key])
  @@index([createdAt])
  @@map("idempotency_keys")
}

model DataQualityIssue {
  id         String      @id @default(uuid()) @db.Uuid
  ruleCode   String      @map("rule_code") @db.VarChar(60)
  dimension  String      @db.VarChar(20)
  entityType String      @map("entity_type") @db.VarChar(60)
  entityId   String      @map("entity_id") @db.Uuid
  spgId      String?     @map("spg_id") @db.Uuid
  severity   Severity
  message    String
  status     IssueStatus @default(OPEN)
  detectedAt DateTime    @default(now()) @map("detected_at") @db.Timestamptz(6)
  resolvedAt DateTime?   @map("resolved_at") @db.Timestamptz(6)
  resolvedById String?   @map("resolved_by_id") @db.Uuid

  @@unique([ruleCode, entityType, entityId])
  @@index([status, severity])
  @@index([spgId])
  @@map("data_quality_issues")
}
